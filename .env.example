# Copy to .env locally. NEVER commit .env.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=student_marks_db

SECRET_KEY=generate-a-long-random-secret
ADMIN_RECOVERY_CODE=generate-a-private-recovery-code

# Production
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1
MAX_CONTENT_LENGTH=536870912

# Large import controls
IMPORT_BATCH_SIZE=2000
MAX_IMPORT_ROWS=500000

# Large imports / deployment timeouts
IMPORT_REQUEST_TIMEOUT=1800

DB_POOL_SIZE=8
WTF_CSRF_TIME_LIMIT=3600
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
RATELIMIT_STORAGE_URI=memory://
